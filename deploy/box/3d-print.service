[Unit]
Description=3d-print API (/print, /photo-check); TripoSR runs on Modal
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/3d-print/app
EnvironmentFile=/etc/3d-print/env
Environment=TRIPOSR_BACKEND=modal PYTHONUNBUFFERED=1 PYTHONWARNINGS=ignore
ExecStart=/opt/3d-print/venv/bin/uvicorn --factory server.print_api:create_print_app --host 127.0.0.1 --port 8000 --timeout-keep-alive 75
MemoryHigh=600M
MemoryMax=750M
MemorySwapMax=1G
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
