#!/bin/bash
# triposr — turn any photo into a printable 3D model.
#
#   triposr photo.jpg
#   triposr chair.jpg --height 800
#   triposr --help
#
# Interpreter order of preference:
#   1. $TRIPOSR_PYTHON, if you set it
#   2. the conda env `triposr`  (recommended; ~/miniconda3/envs/triposr)
#   3. research/triposr_env311  (older venv, kept as a fallback)
# It also points the model caches at the workspace, because the default
# ~/.cache locations are not always writable on this machine.

set -euo pipefail

# Resolve the real script even when invoked through a symlink on PATH (e.g.
# ~/.local/bin/triposr). Without this, BASH_SOURCE stays the symlink path and
# ROOT collapses to ~/.local, which then looks for ~/.local/tools/img2mesh.py.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
SELF="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT="$(cd "$SELF/.." && pwd)"

export HF_HOME="${HF_HOME:-$ROOT/research/hf_cache}"
export U2NET_HOME="${U2NET_HOME:-$ROOT/research/rembg_cache/models/bria-rmbg}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-$ROOT/research/mpl_cache}"
export TOKENIZERS_PARALLELISM=false
export PYTHONWARNINGS="${PYTHONWARNINGS:-ignore}"

# Interpreter search order: explicit override, repo-local venv (the portable
# install, used on Linux/GPU hosts), then the conda env.
LOCAL_VENV_PY="$ROOT/.venv/bin/python"
CONDA_PREFIX_DIR="${CONDA_PREFIX_DIR:-$HOME/miniconda3/envs/triposr}"
CONDA_PY="$CONDA_PREFIX_DIR/bin/python"

if [ -n "${TRIPOSR_PYTHON:-}" ] && [ -x "$TRIPOSR_PYTHON" ]; then
    PY="$TRIPOSR_PYTHON"
elif [ -x "$LOCAL_VENV_PY" ]; then
    PY="$LOCAL_VENV_PY"
elif [ -x "$CONDA_PY" ]; then
    PY="$CONDA_PY"
else
    echo "error: no Python environment found for TripoSR." >&2
    echo "       run ./setup.sh  (it uses conda, or a .venv when conda is unavailable)" >&2
    echo "       or point at an interpreter you built:  TRIPOSR_PYTHON=/path/to/python triposr photo.jpg" >&2
    exit 1
fi

exec "$PY" "$ROOT/tools/img2mesh.py" "$@"
